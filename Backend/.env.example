# AI eBook Creator - backend environment
# Copy this file to server/.env and fill in your values.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/ai-ebook-creator

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Optional: Cloudinary cover storage (leave blank to store files in server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
